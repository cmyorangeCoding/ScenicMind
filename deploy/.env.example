# 复制为 .env 后填写，切勿提交 .env
# cp .env.example .env

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-please
POSTGRES_PASSWORD=change-me-please

# ---------- 大模型（阿里云百炼 / DashScope） ----------
# https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ---------- JWT ----------
# 至少 32 位随机字符串
AUTH_TOKEN_SECRET=please-change-this-user-token-secret-32
ADMIN_TOKEN_SECRET=please-change-this-admin-token-secret-32

# ---------- 阿里云 ----------
ALIOSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=
ALIOSS_ACCESS_KEY_SECRET=
ALIOSS_BUCKET_NAME=
# 智能语音交互（ASR）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
ALIYUN_REGION_ID=cn-shanghai

# ---------- 讯飞数字人 ----------
XFYUN_AVATAR_APP_ID=
XFYUN_AVATAR_API_KEY=
XFYUN_AVATAR_API_SECRET=
XFYUN_AVATAR_SCENE_ID=

# ---------- 其他第三方 ----------
WEATHER_API_KEY=
WECHAT_APPID=
WECHAT_SECRET=
