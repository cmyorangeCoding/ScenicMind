<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cmyhyq.mapper.ComplaintMapper">

    <resultMap id="ComplaintStatsVOResultMap" type="com.cmyhyq.pojo.vo.ComplaintStatsVO">
        <result property="complaintType" column="complaintType"/>
        <result property="count" column="count"/>
        <result property="pendingCount" column="pendingCount"/>
        <result property="processingCount" column="processingCount"/>
    </resultMap>

    <!-- 根据时间范围，按【投诉类型】分组统计投诉数据 -->
    <select id="selectComplaintStats" resultMap="ComplaintStatsVOResultMap">
        SELECT
            complaint_type as complaintType,
            COUNT(*) as count,
            SUM(CASE WHEN status = 0 THEN 1 ELSE 0 END) as pendingCount,
            SUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as processingCount
        FROM complaint
        WHERE create_time &gt;= #{startTime} AND create_time &lt; #{endTime}
        GROUP BY complaint_type
        ORDER BY count DESC
    </select>

</mapper>